<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/vmListFragment">

    <fragment
        android:id="@+id/vmListFragment"
        android:name="cn.moerain.ia64emu.ui.VmListFragment"
        android:label="@string/nav_vm_list"
        tools:layout="@layout/fragment_vm_list" />

    <fragment
        android:id="@+id/vmEditFragment"
        android:name="cn.moerain.ia64emu.ui.VmEditFragment"
        android:label="@string/nav_vm_edit"
        tools:layout="@layout/fragment_vm_edit">
        <argument
            android:name="vmId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/vmDisplayFragment"
        android:name="cn.moerain.ia64emu.ui.VmDisplayFragment"
        android:label="@string/nav_display"
        tools:layout="@layout/fragment_vm_display">
        <argument
            android:name="vmId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/serialFragment"
        android:name="cn.moerain.ia64emu.ui.SerialFragment"
        android:label="@string/nav_serial"
        tools:layout="@layout/fragment_serial">
        <argument
            android:name="vmId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="cn.moerain.ia64emu.ui.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
