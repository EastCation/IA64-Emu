<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <cn.moerain.ia64emu.vnc.VncView
        android:id="@+id/vncView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <cn.moerain.ia64emu.vnc.VncInputView
        android:id="@+id/vncInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|start"
        android:alpha="0.01"
        android:background="@null"
        android:cursorVisible="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:maxLines="1"
        android:textColor="@android:color/transparent"
        android:textColorHint="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC202124"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/display_start"
            android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC121212"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeys"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_extra_keys"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIme"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_ime"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTextInput"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_text_input"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSerial"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_serial"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCtrlAltDel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_ctrl_alt_del"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedia"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_media"
                android:textColor="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExternal"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_external"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopDisplay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_stop"
                android:textColor="#FFFF8A80" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textVncHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/vnc_hint_touch"
        android:textColor="#AAFFFFFF"
        android:textSize="11sp" />
</FrameLayout>
