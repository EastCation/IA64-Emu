<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1B1B20"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabSerial"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/serial_tab_serial"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabQemu"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/serial_tab_qemu"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/serial_empty"
            android:textColor="#FFB9F6CA"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:id="@+id/textSerialHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1B1B20"
        android:padding="8dp"
        android:text="@string/serial_hint"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
